# ==========================================
# NEXUS SMART CONTRACT WALLET - ENVIRONMENT
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------
# Safe to expose to the browser (Next.js)

# Set to true to bypass blockchain interaction for UI testing
NEXT_PUBLIC_USE_DEMO_MODE=false

# The RPC URL for the network (e.g. Sepolia)
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain ID (11155111 for Sepolia)
NEXT_PUBLIC_CHAIN_ID=11155111

# The address of the WalletFactory smart contract on Sepolia
# You will get this address after deploying via the blocknode workspace
NEXT_PUBLIC_FACTORY_ADDRESS=

# ------------------------------------------
# BLOCKCHAIN DEPLOYMENT CONFIGURATION
# ------------------------------------------
# DANGER: NEVER COMMIT REAL SECRETS BELOW
# Keep these safe. Used only in blocknode/ for deployments.

# RPC URL for deployment
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer Private Key (Must have test ETH)
DEPLOYER_PRIVATE_KEY=

# Etherscan API Key for contract verification (Optional)
ETHERSCAN_API_KEY=
